<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{28286C1E-EBB7-4321-9052-7FC96F3DC1E8}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>SpringExpressionsTests</RootNamespace>
    <AssemblyName>SpringExpressionsTests</AssemblyName>
    <TargetFrameworks>net40;net472;netcoreapp2.1;net8.0</TargetFrameworks>
    <FileAlignment>512</FileAlignment>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <Optimize>false</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>


  <!-- .NET Framework only. Keyed on TargetFrameworkIdentifier rather than "!= netcoreapp2.1" so that
       adding a modern TFM does not drag these desktop-only assemblies onto it. They back the
       #if !NETCOREAPP blocks in ExpressionEvaluatorTests.cs (Remoting, Soap, EnterpriseServices). -->
  <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETFramework' ">
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.EnterpriseServices" />
    <Reference Include="System.Runtime.Remoting" />
    <Reference Include="System.Runtime.Serialization.Formatters.Soap" />
    <Reference Include="System.Web.Services" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- BinaryFormatter is used unguarded by three tests (ExpressionEvaluatorTests.TestSerialization*,
       CompiledExpressionTests). On .NET 8 the type still exists but throws unless this switch is on,
       and the API is obsolete as SYSLIB0011. On .NET 9+ it is removed outright, so a future net9.0/
       net10.0 target must guard those tests instead of setting this. -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
  </PropertyGroup>

  <!-- One test framework for every TFM. NUnit 3.13.2 ships lib/net35;net40;net45;netstandard2.0,
       so net40 is supported by the framework - it is only VSTest that cannot host net40. -->
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.13.2" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net40' ">
    <Reference Include="System.Core" />
  </ItemGroup>
  
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <Reference Include="System.Core" />
  </ItemGroup> 

  <!-- VSTest ("dotnet test") for the two TFMs that can host it. Microsoft.NET.Test.Sdk 17.0.0 has an
       EMPTY .NETFramework4.0 dependency group - no test host - so net40 is excluded on purpose.
       Referencing it there would silently produce a run that discovers nothing and exits 0.

       The adapter version differs per TFM, and both values are load-bearing:
        - net472 needs >= 5.0.0. Adapter 4.2.1 bundles nunit.engine 3.13, which throws
          "Unknown framework version 10.0" while enumerating installed runtimes on a machine with
          .NET 10 present, so discovery dies before a single test runs.
        - netcoreapp2.1 needs 4.2.1, the last version shipping a netcoreapp2.1 asset. 5.x ships only
          net462 + netcoreapp3.1; on netcoreapp2.1 the net462 asset gets loaded and fails on the
          missing System.Runtime.Remoting.Channels.IChannel.
        - net8.0 uses 5.0.0's netcoreapp3.1 asset. -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netcoreapp2.1' ">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.2.1" />
  </ItemGroup>

  <!-- net40 is run by nunit3-console instead - see run-net40-tests.ps1. Tools-only package:
       ExcludeAssets keeps it out of compile/output, GeneratePathProperty exposes
       $(PkgNUnit_ConsoleRunner) so a fresh clone restores the runner rather than relying on a cache hit. -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net40' ">
    <PackageReference Include="NUnit.ConsoleRunner" Version="3.22.0"
                      ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpringExpressions\SpringExpressions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>